# Copy to .env  (chmod 600). NEVER commit it or paste these values anywhere.

# Required. Fine-grained token. Repository access: only YOUR repos you want
# maintained, with Contents / Issues / Pull requests = Read and write.
# (Fine-grained tokens can always read public repos, so scout works too.)
GITHUB_TOKEN=

# Console login - DON'T fill these by hand. Run:
#   python nightops.py set-password
#   python nightops.py setup-2fa
NIGHTOPS_USER=
NIGHTOPS_PASSWORD_HASH=
NIGHTOPS_TOTP_SECRET=

# Optional AI keys (only used if ai.enabled is true). Fill the ones you use.
#   Gemini:     https://aistudio.google.com/apikey
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: push alarms to Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: more chats/people allowed to use the bot (comma separated ids).
# Anyone not listed here or in TELEGRAM_CHAT_ID is ignored.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

# Optional: Freelancer.com project search (read-only). Get it at
# accounts.freelancer.com/settings/develop -> Generate Token. Never share it.
FREELANCER_OAUTH_TOKEN=
# Optional: a SECOND Telegram bot just for freelance work (create it with
# @BotFather). Only TELEGRAM_CHAT_ID / TELEGRAM_ALLOWED_CHAT_IDS can use it.
FREELANCE_BOT_TOKEN=

# Optional: email (Gmail needs an App Password)
SMTP_USER=
SMTP_PASSWORD=
