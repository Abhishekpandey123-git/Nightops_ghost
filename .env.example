# Copy to .env  (chmod 600). NEVER commit it or paste these values anywhere.

# Required. Fine-grained token. Repository access: only YOUR repos you want
# maintained, with Contents / Issues / Pull requests = Read and write.
# (Fine-grained tokens can always read public repos, so scout works too.)
GITHUB_TOKEN=

# Console login - DON'T fill these by hand. Run:
#   python nightops.py set-password
#   python nightops.py setup-2fa
NIGHTOPS_USER=
NIGHTOPS_PASSWORD_HASH=
NIGHTOPS_TOTP_SECRET=

# Optional: only if ai.enabled is true (e.g. a Groq key)
AI_API_KEY=

# Optional: push alarms to Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: email (Gmail needs an App Password)
SMTP_USER=
SMTP_PASSWORD=
